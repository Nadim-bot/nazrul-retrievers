rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Since this application is fully server-brokered (clients communicate with Express, which in turn syncs to Firestore),
    // we allow read/write access so the backend can seamlessly persist data.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
